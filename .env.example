# Copy to .env (gitignored) and fill in as needed. vnote also reads plain
# environment variables — a .env file is just a convenience. Environment
# variables override the settings saved by the web UI / `vnote --setup`
# (~/.config/vnote/config.json); `vnote --config` shows every setting with
# where its value comes from.

# Required ONLY for the metered API backend (`vnote --backend claude`).
# `--backend claude-code` and `--backend opencode` need no key at all — they use
# your Claude subscription / your existing opencode provider setup.
ANTHROPIC_API_KEY=

# --- Optional overrides (defaults shown) ---
# VNOTE_BACKEND=ollama                     # ollama | claude-code | opencode | claude
# VNOTE_STYLE=edit                         # default cleanup style (a file in your styles folders)
# VNOTE_LANGUAGE=                          # force a transcription language (en, de, ...); blank = auto
# VNOTE_OLLAMA_MODEL=qwen2.5:14b-instruct
# OLLAMA_HOST=http://127.0.0.1:11434
# VNOTE_OLLAMA_KEEP_ALIVE=30m               # how long Ollama holds the model after a request; -1 = forever
# VNOTE_CLAUDE_CODE_BIN=claude             # --backend claude-code: path to the CLI
# VNOTE_OPENCODE_BIN=opencode              # --backend opencode: path to the CLI
# VNOTE_OPENCODE_MODEL=                    # --backend opencode: provider/model
#                                          #   (unset = opencode's own default;
#                                          #    `opencode models` lists the ids)
# VNOTE_OPENCODE_PURE=1                    # 0 = load opencode's external plugins
# VNOTE_DOUBLE_CLEAN=0                     # 1 = save two cleanups per note: <folder>_note.md (temp 0)
#                                          #     + <folder>_note_variant_t3.md (temp 0.3 below)
# VNOTE_VARIANT_TEMPERATURE=0.3            # temp for the 2nd (varied) pass; the file name encodes it (t3, t4, ...)
# VNOTE_CLAUDE_MODEL=claude-sonnet-5       # --backend claude only

# --- Bound when the daemon starts (change + restart) ---
# VNOTE_DIR=./voice-notes
# VNOTE_WHISPER_MODEL=                      # small on CPU / large-v3-turbo on CUDA; unset = device default
# VNOTE_DAEMON_HOST=127.0.0.1
# VNOTE_DAEMON_PORT=8760
# VNOTE_VOCAB=~/.config/vnote/vocab.txt
# VNOTE_STYLES_DIRS=                       # extra style folders, ':'-separated; each overrides the built-ins
