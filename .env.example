# Copy to .env (gitignored) and fill in as needed. vnote also reads plain
# environment variables — a .env file is just a convenience. Environment
# variables override the settings saved by the web UI / `vnote --setup`
# (~/.config/vnote/config.json); `vnote --config` shows every setting with
# where its value comes from.

# Required ONLY for the metered API backend (`vnote --backend claude`).
# `--backend claude-code` needs no key at all — it uses your Claude subscription.
ANTHROPIC_API_KEY=

# --- Optional overrides (defaults shown) ---
# VNOTE_BACKEND=ollama                     # ollama | claude-code | claude
# VNOTE_MODE=edit                          # default cleanup mode: light | edit | summary | dictation
# VNOTE_LANGUAGE=                          # force a transcription language (en, de, ...); blank = auto
# VNOTE_OLLAMA_MODEL=qwen2.5:14b-instruct
# VNOTE_DICTATION_MODEL=                   # small/fast model for dictation mode; blank = ollama_model
# OLLAMA_HOST=http://127.0.0.1:11434
# VNOTE_OLLAMA_KEEP_ALIVE=30m               # how long Ollama holds the model after a request; -1 = forever
# VNOTE_CLAUDE_CODE_BIN=claude             # --backend claude-code: path to the CLI
# VNOTE_CLAUDE_MODEL=claude-sonnet-5       # --backend claude only

# --- Bound when the daemon starts (change + restart) ---
# VNOTE_DIR=./voice-notes
# VNOTE_WHISPER_MODEL=large-v3-turbo
# VNOTE_DAEMON_HOST=127.0.0.1
# VNOTE_DAEMON_PORT=8760
# VNOTE_VOCAB=~/.config/vnote/vocab.txt
