# Copy to .env (gitignored) and fill in as needed. vnote also reads plain
# environment variables — a .env file is just a convenience.

# Required ONLY for the metered API backend (`vnote --backend claude`).
# `--backend claude-code` and `--backend opencode` need no key at all — they use
# your Claude subscription / your existing opencode provider setup.
ANTHROPIC_API_KEY=

# --- Optional overrides (defaults shown) ---
# VNOTE_DIR=./voice-notes
# VNOTE_WHISPER_MODEL=small                # base | small | large-v3-turbo (use large-v3-turbo on CUDA)
# VNOTE_BACKEND=ollama                     # ollama | claude-code | opencode | claude
# VNOTE_OLLAMA_MODEL=qwen2.5:14b-instruct
# VNOTE_CLAUDE_CODE_BIN=claude             # --backend claude-code: path to the CLI
# VNOTE_OPENCODE_BIN=opencode              # --backend opencode: path to the CLI
# VNOTE_OPENCODE_MODEL=                    # --backend opencode: provider/model
#                                          #   (unset = opencode's own default;
#                                          #    `opencode models` lists the ids)
# VNOTE_OPENCODE_PURE=1                    # 0 = load opencode's external plugins
# VNOTE_CLAUDE_MODEL=claude-sonnet-5       # --backend claude only
# OLLAMA_HOST=http://127.0.0.1:11434
